<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>ПростикРостик</title>

<style>
body {
  margin: 0;
  font-family: Arial;
  transition: 0.3s;
}

body.dark {
  background: #0f172a;
  color: white;
}

body.light {
  background: #f1f5f9;
  color: black;
}

header {
  padding: 15px;
  font-size: 18px;
  display: flex;
  justify-content: space-between;
}

.dark header { background: #1e293b; }
.light header { background: #e2e8f0; }

#chat {
  height: 70vh;
  overflow-y: auto;
  padding: 10px;
  display: flex;
  flex-direction: column;
}

.message {
  max-width: 60%;
  width: fit-content;
  padding: 10px;
  margin: 5px;
  border-radius: 12px;
  position: relative;
}

.me {
  align-self: flex-end;
  background: #3b82f6;
  color: white;
}

.dark .other { background: #334155; }
.light .other { background: #e2e8f0; }

.name {
  font-size: 11px;
  opacity: 0.7;
}

#inputArea {
  display: flex;
  padding: 10px;
}

.dark #inputArea { background: #1e293b; }
.light #inputArea { background: #e2e8f0; }

input {
  flex: 1;
  padding: 10px;
  border-radius: 10px;
  border: none;
}

button {
  margin-left: 10px;
  padding: 10px;
  border-radius: 10px;
  cursor: pointer;
}
</style>
</head>

<body class="dark">

<header>
  ПростикРостик
  <button onclick="toggleTheme()">🌗</button>
</header>

<div style="padding:10px;">
  <button onclick="login()">Войти через Google</button>
  <button onclick="logout()">Выйти</button>
  <div id="userInfo"></div>
</div>

<div id="chat"></div>

<div id="inputArea">
  <input id="messageInput" placeholder="Сообщение..." />
  <button onclick="sendMessage()">➤</button>
</div>

<!-- Firebase -->
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>

<script>
window.onload = function () {

  // 🌗 тема
  window.toggleTheme = function () {
    if (document.body.classList.contains("dark")) {
      document.body.classList.remove("dark");
      document.body.classList.add("light");
    } else {
      document.body.classList.remove("light");
      document.body.classList.add("dark");
    }
  };

  // 🔥 Firebase config
  const firebaseConfig = {
    apiKey: "AIzaSyDe5k1pVFUxSB33pxwtivIorB0VQ1atc08",
    authDomain: "prostikrostik-90812.firebaseapp.com",
    projectId: "prostikrostik-90812"
  };

  firebase.initializeApp(firebaseConfig);

  const auth = firebase.auth();
  const db = firebase.firestore();

  let currentUser = null;

  // 🔐 вход
  window.login = function () {
    const provider = new firebase.auth.GoogleAuthProvider();
    auth.signInWithPopup(provider);
  };

  // 🔓 выход
  window.logout = function () {
    auth.signOut();
  };

  // 👤 пользователь
  auth.onAuthStateChanged(user => {
    currentUser = user;
    document.getElementById("userInfo").innerText =
      user ? "Ты: " + user.displayName : "Не вошёл";
  });

  // 💬 отправка
  window.sendMessage = function () {
    const input = document.getElementById("messageInput");
    if (!input.value || !currentUser) return;

    db.collection("messages").add({
      text: input.value,
      user: currentUser.displayName,
      uid: currentUser.uid,
      time: Date.now()
    });

    input.value = "";
  };

  const chat = document.getElementById("chat");

  // 📡 чат
  db.collection("messages").orderBy("time")
  .onSnapshot(snapshot => {
    chat.innerHTML = "";

    snapshot.forEach(docSnap => {
      const data = docSnap.data();
      const isMe = currentUser && data.uid === currentUser.uid;

      const div = document.createElement("div");
      div.className = "message " + (isMe ? "me" : "other");

      div.innerHTML = `
        <div class="name">${data.user}</div>
        ${data.text}
      `;

      chat.appendChild(div);
    });

    chat.scrollTop = chat.scrollHeight;
  });

};
</script>

</body>
</html>
